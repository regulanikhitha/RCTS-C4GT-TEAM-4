{
  "info": {
    "_postman_id": "c4gt-hub-full-system-2026",
    "name": "C4GT Hub Attendance API — Production Suite",
    "description": "Complete Postman collection covering Authentication, RBAC Role Guards, 81 Member Management, Attendance Marking (Single & Bulk), Analytics/Stats, PDF Report Downloads, and Coordinator Whitelist Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "coordToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "C4GT-001",
      "type": "string"
    },
    {
      "key": "attendanceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('adminToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@c4gt.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.2 Coordinator Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('coordToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coordinator1@c4gt.com\",\n  \"password\": \"Coord@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.3 Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('studentToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member001@c4gt.com\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.4 Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Member Management",
      "item": [
        {
          "name": "2.1 List All 81 Members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{coordToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/members", "host": ["{{baseUrl}}"], "path": ["api", "members"] }
          }
        },
        {
          "name": "2.2 Filter Members by Role (Junior Developer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{coordToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/members?role=Junior Developer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"],
              "query": [{ "key": "role", "value": "Junior Developer" }]
            }
          }
        },
        {
          "name": "2.3 Get Member by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{coordToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/members/{{memberId}}", "host": ["{{baseUrl}}"], "path": ["api", "members", "{{memberId}}"] }
          }
        },
        {
          "name": "2.4 Create Member (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": \"C4GT-082\",\n  \"name\": \"Kavya Nair\",\n  \"email\": \"kavya.nair@c4gt.com\",\n  \"role\": \"Junior Developer\",\n  \"department\": \"Cloud & DevOps\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/members", "host": ["{{baseUrl}}"], "path": ["api", "members"] }
          }
        },
        {
          "name": "2.5 Update Member (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Senior Developer\",\n  \"department\": \"AI/ML Systems\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/members/C4GT-082", "host": ["{{baseUrl}}"], "path": ["api", "members", "C4GT-082"] }
          }
        },
        {
          "name": "2.6 Delete Member (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/members/C4GT-082", "host": ["{{baseUrl}}"], "path": ["api", "members", "C4GT-082"] }
          }
        }
      ]
    },
    {
      "name": "3. Attendance Operations",
      "item": [
        {
          "name": "3.1 Mark Single Attendance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.attendance && json.attendance._id) {",
                  "        pm.collectionVariables.set('attendanceId', json.attendance._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{coordToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": \"C4GT-001\",\n  \"date\": \"2026-08-25\",\n  \"status\": \"Present\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/attendance", "host": ["{{baseUrl}}"], "path": ["api", "attendance"] }
          }
        },
        {
          "name": "3.2 Mark Bulk Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{coordToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-08-25\",\n  \"records\": [\n    { \"memberId\": \"C4GT-001\", \"status\": \"Present\" },\n    { \"memberId\": \"C4GT-002\", \"status\": \"Present\" },\n    { \"memberId\": \"C4GT-003\", \"status\": \"Absent\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/attendance/bulk", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "bulk"] }
          }
        },
        {
          "name": "3.3 Update Attendance & Log Audit",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{coordToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Absent\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/attendance/{{attendanceId}}", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "{{attendanceId}}"] }
          }
        },
        {
          "name": "3.4 Get Daily Attendance (All 81 Members)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{coordToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/attendance?date=2026-08-24",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [{ "key": "date", "value": "2026-08-24" }]
            }
          }
        },
        {
          "name": "3.5 Get Attendance Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{coordToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/stats?date=2026-08-24",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "stats"],
              "query": [{ "key": "date", "value": "2026-08-24" }]
            }
          }
        },
        {
          "name": "3.6 Student View Own Attendance History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/attendance/member/C4GT-001", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "member", "C4GT-001"] }
          }
        },
        {
          "name": "3.7 Download Daily Attendance PDF Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{coordToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/attendance/report/2026-08-24", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "report", "2026-08-24"] }
          }
        }
      ]
    },
    {
      "name": "4. Coordinator Management",
      "item": [
        {
          "name": "4.1 List All Authorized Coordinators (Admin Only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/coordinators", "host": ["{{baseUrl}}"], "path": ["api", "coordinators"] }
          }
        },
        {
          "name": "4.2 Add Coordinator to Whitelist (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sneha Patel (Coordinator)\",\n  \"email\": \"coordinator3@c4gt.com\",\n  \"department\": \"Community Operations\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/coordinators", "host": ["{{baseUrl}}"], "path": ["api", "coordinators"] }
          }
        }
      ]
    }
  ]
}
